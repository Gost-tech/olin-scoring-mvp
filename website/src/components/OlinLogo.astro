---
interface Props {
  compact?: boolean;
  inverse?: boolean;
}

const { compact = false, inverse = false } = Astro.props;
---

<span class:list={["olin-logo", { "olin-logo--compact": compact, "olin-logo--inverse": inverse }]}>
  <svg class="olin-logo__mark" viewBox="0 0 44 44" aria-hidden="true">
    <path d="M6 11.5h11.4c4.1 0 5.8 2.2 7.7 5.5l2.8 5c1.8 3.2 3.7 5.4 7.9 5.4H38" />
    <path d="M6 22h7.8c4.2 0 6.2 0 8.4 0H38" />
    <path d="M6 32.5h11.4c4.1 0 5.8-2.2 7.7-5.5l2.8-5c1.8-3.2 3.7-5.4 7.9-5.4H38" />
    <circle cx="38" cy="22" r="3.5" />
  </svg>
  <span class="olin-logo__word" aria-hidden={compact ? "true" : undefined}>OLIN</span>
  {compact && <span class="sr-only">Olin</span>}
</span>

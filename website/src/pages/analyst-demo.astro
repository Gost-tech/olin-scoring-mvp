---
import BaseLayout from "../layouts/BaseLayout.astro";
import AnalystConsole from "../components/AnalystConsole";
---

<BaseLayout title="Analyst demo | Olin" description="Synthetic analyst review console for Olin." noIndex>
  <section class="page-hero" aria-labelledby="analyst-title"><div class="shell page-hero__inner"><div><p class="eyebrow">Investor demo · analyst side</p><h1 id="analyst-title">A queue your credit team<br /><em>can actually review.</em></h1></div><div class="page-hero__aside"><p>Every case has a route, evidence status, rationale and recorded partner action. This demo uses synthetic cases and cannot approve or disburse money.</p></div></div></section>
  <section class="section section--paper"><div class="shell"><AnalystConsole client:load /><p class="explorer-disclaimer">Synthetic dashboard. Production access control, partner integrations and real evidence are required before operational use.</p></div></section>
</BaseLayout>

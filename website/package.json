{
  "name": "olin-public-site",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 8001",
    "build": "astro check && astro build",
    "preview": "astro preview --host 127.0.0.1 --port 8001",
    "check": "astro check",
    "qa:static": "node scripts/qa-static.mjs",
    "test": "pnpm run build && pnpm run qa:static",
    "deploy": "pnpm run test && pnpm dlx wrangler@latest deploy --config wrangler.jsonc",
    "video:build": "zsh demo-output/build.sh"
  },
  "dependencies": {
    "@astrojs/react": "6.0.1",
    "astro": "7.0.9",
    "motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "ffmpeg-static": "^5.3.0",
    "typescript": "6.0.3"
  }
}

{
  "$schema": "investigator-authority.schema.json",
  "contract_version": "investigator-authority-1.5",
  "default": "deny",
  "deployment_profile": "investigator_v1_phase6",
  "principals": ["investigator_runtime", "investigator_action_writer"],
  "capabilities": {
    "case.create": {
      "decision": "allow",
      "principals": ["investigator_runtime"],
      "effect": "INVESTIGATION_RECORD",
      "reads": [],
      "writes": ["investigator.investigation_case", "investigator.investigation_event"]
    },
    "case.read": {
      "decision": "allow",
      "principals": ["investigator_runtime"],
      "effect": "READ_INVESTIGATION_RECORD",
      "reads": ["investigator.investigation_case", "investigator.investigation_event"],
      "writes": []
    },
    "event.append": {
      "decision": "allow",
      "principals": ["investigator_runtime"],
      "effect": "INVESTIGATION_RECORD",
      "reads": ["investigator.investigation_case", "investigator.investigation_event"],
      "writes": ["investigator.investigation_case", "investigator.investigation_event"]
    },
    "snapshot.create": {
      "decision": "allow",
      "principals": ["investigator_runtime"],
      "effect": "SNAPSHOT_RECORD",
      "reads": ["investigator.investigation_case", "investigator.investigation_event"],
      "writes": ["investigator.case_snapshot", "investigator.case_snapshot_request"]
    },
    "snapshot.read": {
      "decision": "allow",
      "principals": ["investigator_runtime"],
      "effect": "READ_SNAPSHOT_RECORD",
      "reads": ["investigator.case_snapshot", "investigator.case_snapshot_invalidation", "investigator.is_snapshot_current"],
      "writes": []
    },
    "snapshot.invalidate": {
      "decision": "allow",
      "principals": ["investigator_runtime"],
      "effect": "SNAPSHOT_RECORD",
      "reads": ["investigator.investigation_case", "investigator.investigation_event", "investigator.case_snapshot", "investigator.case_snapshot_invalidation"],
      "writes": ["investigator.investigation_case", "investigator.investigation_event", "investigator.case_snapshot_invalidation"]
    },
    "evidence.reference.read": {
      "decision": "allow",
      "principals": ["investigator_runtime"],
      "effect": "READ_EVIDENCE_REFERENCE",
      "reads": ["investigator.investigation_evidence_reference", "investigator.investigation_evidence_semantics"],
      "writes": []
    },
    "snapshot.v2.create": {
      "decision": "allow",
      "principals": ["investigator_runtime"],
      "effect": "SNAPSHOT_RECORD",
      "reads": ["investigator.investigation_case", "investigator.investigation_event", "investigator.investigation_evidence_reference"],
      "writes": ["investigator.case_snapshot", "investigator.case_snapshot_request"]
    },
    "snapshot.reasoning.require": {
      "decision": "allow",
      "principals": ["investigator_runtime"],
      "effect": "REASONING_CURRENTNESS_GATE",
      "reads": ["investigator.investigation_case", "investigator.investigation_event", "investigator.case_snapshot", "investigator.case_snapshot_invalidation", "investigator.investigation_evidence_reference", "investigator.investigation_evidence_semantics", "investigator.current_canonical_authority_revision"],
      "writes": []
    },
    "investigation_action.select": {
      "decision": "allow",
      "principals": ["investigator_action_writer"],
      "effect": "INVESTIGATION_ACTION_RECORD",
      "reads": ["investigator.investigation_case", "investigator.case_snapshot", "investigator.case_snapshot_invalidation", "evidence_authority.investigator_evidence_projection_change"],
      "writes": ["investigator.investigation_action", "investigator.investigation_action_transition"]
    },
    "investigation_action.transition": {
      "decision": "allow",
      "principals": ["investigator_action_writer"],
      "effect": "INVESTIGATION_ACTION_RECORD",
      "reads": ["investigator.investigation_action", "investigator.investigation_action_transition"],
      "writes": ["investigator.investigation_action_transition"]
    },
    "investigation_action.read": {
      "decision": "allow",
      "principals": ["investigator_action_writer"],
      "effect": "READ_INVESTIGATION_ACTION_RECORD",
      "reads": ["investigator.investigation_action", "investigator.investigation_action_transition"],
      "writes": []
    },
    "credit.approve": {"decision": "deny", "principals": [], "effect": "CREDIT_APPROVE"},
    "credit.decline": {"decision": "deny", "principals": [], "effect": "CREDIT_DECLINE"},
    "credit.price": {"decision": "deny", "principals": [], "effect": "PRICE_SET"},
    "credit.terms.set": {"decision": "deny", "principals": [], "effect": "AUTHORITATIVE_TERMS_SET"},
    "credit.limit.change": {"decision": "deny", "principals": [], "effect": "LIMIT_CHANGE"},
    "money.disburse": {"decision": "deny", "principals": [], "effect": "DISBURSE"},
    "money.collect": {"decision": "deny", "principals": [], "effect": "COLLECT"},
    "facility.graduate": {"decision": "deny", "principals": [], "effect": "GRADUATE"},
    "repayment.trigger": {"decision": "deny", "principals": [], "effect": "REPAYMENT_TRIGGER"},
    "bank_policy.override": {"decision": "deny", "principals": [], "effect": "POLICY_OVERRIDE"},
    "verified_evidence.mutate": {"decision": "deny", "principals": [], "effect": "VERIFIED_EVIDENCE_MUTATE"},
    "canonical_evidence.delete": {"decision": "deny", "principals": [], "effect": "CANONICAL_EVIDENCE_DELETE"},
    "source_trust.grant": {"decision": "deny", "principals": [], "effect": "SOURCE_TRUST_GRANT"},
    "consent.create": {"decision": "deny", "principals": [], "effect": "CONSENT_CREATE"},
    "consent.approve": {"decision": "deny", "principals": [], "effect": "CONSENT_APPROVE"},
    "consent.receipt.mutate": {"decision": "deny", "principals": [], "effect": "CONSENT_RECEIPT_MUTATE"},
    "permission.grant": {"decision": "deny", "principals": [], "effect": "PERMISSION_GRANT"},
    "money_credentials.read": {"decision": "deny", "principals": [], "effect": "MONEY_CREDENTIAL_READ"},
    "provider.call": {"decision": "deny", "principals": [], "effect": "EXTERNAL_ACQUISITION"},
    "ai.invoke": {"decision": "deny", "principals": [], "effect": "AI_REASONING"}
  },
  "forbidden_surfaces": {
    "python_modules": [
      "olin.api.cases",
      "olin.capacity_v2",
      "olin.collection",
      "olin.fraud",
      "olin.graduation",
      "olin.portfolio",
      "olin.repayment",
      "olin.scorecard",
      "olin.server",
      "olin.store",
      "olin.stp",
      "olin.belvo",
      "olin.denue",
      "olin.geointelligence",
      "olin.investigator_evidence_adapter",
      "olin.places",
      "olin.syncfy",
      "olin.weather"
    ],
    "python_symbols": [
      "olin.store.ScoringLog",
      "olin.stp.disburse",
      "olin.collection.process_incoming_payment",
      "olin.collection.attempt_partial_domiciliacion",
      "olin.collection.mark_defaulted",
      "olin.portfolio.check_portfolio",
      "olin.graduation.get_graduation_offer",
      "olin.repayment.assess_repayment",
      "olin.repayment.suggest_max_affordable_amount",
      "olin.scorecard.score_application",
      "olin.capacity_v2.calculate_capacity",
      "olin.evidence_passport.register_verified_evidence",
      "olin.evidence_passport.revoke_evidence"
    ],
    "routes": [
      "POST /api/applications",
      "POST /api/apps/{id}/decision",
      "POST /api/apps/{id}/outcome",
      "POST /api/apps/{id}/disburse",
      "POST /api/webhook/stp",
      "POST /api/v1/intakes/{id}/score",
      "POST /api/v1/webhooks/bank-evidence",
      "POST /api/v1/link-sessions/exchange",
      "POST /api/evidence/*",
      "POST /api/v1/evidence/*"
    ],
    "database_tables": [
      "public.scoring_log",
      "public.payment_ledger",
      "public.shadow_performance_event",
      "public.evidence_record",
      "public.consent_record",
      "public.data_authorization_record",
      "public.correction_request",
      "public.bank_ingestion_event",
      "public.intake",
      "public.intake_consent",
      "public.consent_policy",
      "public.intake_identity_binding",
      "public.consent_challenge",
      "public.consent_withdrawal_task",
      "public.intake_link_session",
      "public.intake_bank_event",
      "public.intake_audit_event"
    ],
    "environment_prefixes": ["STP_", "BELVO_", "SYNCFY_", "OPENAI_", "ANTHROPIC_"],
    "environment_variables": [
      "GOOGLE_PLACES_API_KEY",
      "INEGI_DENUE_TOKEN",
      "OLIN_ANALYST_TOKEN",
      "OLIN_API_KEYS",
      "OLIN_BANK_WEBHOOK_SECRET",
      "OLIN_BANK_WEBHOOK_SECRETS",
      "OLIN_LIVE_LENDING_APPROVAL_REF",
      "OLIN_LIVE_LENDING_APPROVED_BY",
      "OLIN_LIVE_LENDING_ENABLED",
      "OLIN_LIVE_LENDING_KILL_SWITCH",
      "OLIN_LIVE_LENDING_SECOND_APPROVER",
      "OLIN_STP_WEBHOOK_SECRET",
      "OLIN_USERS",
      "OLIN_VALIDATED_AUTO_APPROVE_TYPES",
      "OLIN_TRUSTED_SOURCE_REGISTRY",
      "OLIN_TRUSTED_SOURCE_REGISTRY_FILE"
    ],
    "jobs": [
      "jobs.daily collection/overdue/default processing",
      "any disbursement, repayment, collection, graduation, scoring, provider, or evidence-acquisition worker"
    ],
    "network_capabilities": [
      "STP sandbox and production",
      "bank LOS write APIs",
      "bank evidence webhooks and link exchange",
      "Belvo",
      "Syncfy",
      "Google Places",
      "INEGI DENUE",
      "weather providers",
      "LLM and agent tool endpoints",
      "general Internet egress"
    ],
    "caller_trust_labels": ["verified", "trusted", "authoritative", "issuer_validated", "source_verified", "official", "validated", "independent", "independence_status", "semantic_lineage_id", "economic_event_id", "derived_from_evidence_id", "independence_attestation_id"]
  },
  "allowed_routes": [
    "GET /investigator",
    "POST /api/session",
    "GET /api/cases/{case_id}",
    "GET /api/cases/{case_id}/report",
    "GET /api/cases/{case_id}/actions",
    "POST /api/cases/{case_id}/actions",
    "POST /api/cases/{case_id}/actions/{action_id}/transitions",
    "POST /api/cases/{case_id}/actions/{action_id}/synthetic-response"
  ],
  "allowed_event_types": ["CASE_CREATED", "INVESTIGATION_EVENT_RECORDED", "CASE_SNAPSHOT_INVALIDATED", "EVIDENCE_ACCEPTED", "EVIDENCE_BECAME_UNUSABLE", "CONSENT_STATE_CHANGED"],
  "allowed_environment_variables": [
    "HOME",
    "HOSTNAME",
    "LANG",
    "LC_ALL",
    "LOG_LEVEL",
    "OLIN_INVESTIGATOR_AUTH_AUDIENCE",
    "OLIN_INVESTIGATOR_AUTH_ISSUER",
    "OLIN_INVESTIGATOR_ACTION_DATABASE_URL",
    "OLIN_INVESTIGATOR_CANONICAL_READER_DATABASE_URL",
    "OLIN_INVESTIGATOR_DATABASE_URL",
    "OLIN_INVESTIGATOR_SESSION_SECRET",
    "OLIN_INVESTIGATOR_SYNTHETIC_OPERATOR_TOKEN",
    "OLIN_INVESTIGATOR_SYNTHETIC_OPERATOR_URL",
    "OLIN_INVESTIGATOR_USERS",
    "PATH",
    "PORT",
    "PYTHONDONTWRITEBYTECODE",
    "PYTHONUNBUFFERED",
    "TMPDIR",
    "TZ"
  ],
  "prohibited_environment_variables": [
    "OLIN_INVESTIGATOR_EVIDENCE_AUTHORITY_DATABASE_URL",
    "OLIN_CANONICAL_EVIDENCE_DATABASE_URL",
    "OLIN_EVIDENCE_AUTHORITY_DATABASE_PASSWORD",
    "OLIN_CANONICAL_EVIDENCE_DATABASE_PASSWORD"
  ],
  "allowed_database_objects": [
    "investigator.investigation_case",
    "investigator.investigation_event",
    "investigator.case_snapshot",
    "investigator.case_snapshot_invalidation",
    "investigator.case_snapshot_request",
    "investigator.investigation_evidence_reference",
    "investigator.investigation_evidence_semantics",
    "investigator.create_case",
    "investigator.append_event",
    "investigator.create_snapshot",
    "investigator.invalidate_snapshot",
    "investigator.is_snapshot_current",
    "investigator.create_snapshot_v2",
    "investigator.current_canonical_authority_revision",
    "investigator.session_tenant_id",
    "investigator.context_tenant_id",
    "investigator.tenant_access_allowed"
    ,"investigator.investigation_action"
    ,"investigator.investigation_action_transition"
    ,"investigator.action_session_tenant_id"
    ,"investigator.action_tenant_access_allowed"
    ,"investigator.select_investigation_action"
    ,"investigator.transition_investigation_action"
    ,"investigator.read_investigation_actions"
    ,"evidence_authority.investigator_evidence_projection_change"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://olin.example/schemas/investigator-authority-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "default", "deployment_profile", "principals", "capabilities", "forbidden_surfaces", "allowed_routes", "allowed_event_types", "allowed_environment_variables", "allowed_database_objects"],
  "properties": {
    "$schema": {"type": "string"},
    "contract_version": {"const": "investigator-authority-1.2"},
    "default": {"const": "deny"},
    "deployment_profile": {"const": "investigator_v1_phase2"},
    "principals": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision", "principals", "effect"],
        "properties": {
          "decision": {"enum": ["allow", "deny"]},
          "principals": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "effect": {"type": "string", "minLength": 1},
          "reads": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "writes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "forbidden_surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python_modules", "python_symbols", "routes", "database_tables", "environment_prefixes", "environment_variables", "jobs", "network_capabilities", "caller_trust_labels"],
      "properties": {
        "python_modules": {"$ref": "#/$defs/stringSet"},
        "python_symbols": {"$ref": "#/$defs/stringSet"},
        "routes": {"$ref": "#/$defs/stringSet"},
        "database_tables": {"$ref": "#/$defs/stringSet"},
        "environment_prefixes": {"$ref": "#/$defs/stringSet"},
        "environment_variables": {"$ref": "#/$defs/stringSet"},
        "jobs": {"$ref": "#/$defs/stringSet"},
        "network_capabilities": {"$ref": "#/$defs/stringSet"},
        "caller_trust_labels": {"$ref": "#/$defs/stringSet"}
      }
    },
    "allowed_routes": {"$ref": "#/$defs/stringSet"},
    "allowed_event_types": {"$ref": "#/$defs/stringSet"},
    "allowed_environment_variables": {"$ref": "#/$defs/stringSet"},
    "allowed_database_objects": {"$ref": "#/$defs/stringSet"}
  },
  "$defs": {
    "stringSet": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}

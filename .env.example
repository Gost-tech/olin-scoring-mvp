# ── Syncfy (open banking connector — replaced Belvo in MX) ───────────
# Get your key at: https://syncfy.com/developers
SYNCFY_API_KEY=your_syncfy_api_key_here

# ── Google Places API (Maps rating + business tenure) ─────────────────
# Enable "Places API" in Google Cloud Console, then create an API key.
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# ── INEGI DENUE (persistent public establishment evidence) ───────────
# Register for a free token: https://www.inegi.org.mx/servicios/api_denue.html
INEGI_DENUE_TOKEN=your_inegi_denue_token_here

# ── STP / SPEI (disbursement rail) ────────────────────────────────────
# Credentials provided by STP when you register as a participant.
# Set STP_SANDBOX=1 for demo.stpmex.com (no real certs needed).
# Set STP_SANDBOX=0 for production (cert + key required).
STP_EMPRESA=YOURCODE
STP_CUENTA_ORDENANTE=000000000000000000
STP_RFC_ORDENANTE=OLI200101AB1
STP_PRIVATE_KEY_PATH=./certs/stp_private_key.pem
STP_CERT_PATH=./certs/stp_cert.pem
STP_SANDBOX=1

# ── Database ──────────────────────────────────────────────────────────
# Default: olin_scoring.db in the project root.
# Override to use an absolute path in production.
# OLIN_DB_PATH=/var/data/olin_scoring.db
# Olin runtime: demo | pilot | production | test
# pilot = real verified evidence, named users, separate DB, no money movement
OLIN_MODE=demo

# Required in production. Named users and explicit roles are required for real data.
# OLIN_USERS={"bank_ingestion":{"token":"replace-with-32+-random-characters","role":"partner"},"risk_reviewer":{"token":"replace-with-32+-random-characters","role":"analyst"},"olin_operator":{"token":"replace-with-32+-random-characters","role":"admin"}}
OLIN_USERS=
# Legacy synthetic/pilot compatibility only; do not use for a new real-data deployment.
# OLIN_API_KEYS={"brice":"replace-with-a-long-random-token","partner_analyst":"replace-me"}
OLIN_API_KEYS=
# Backward-compatible single-user fallback:
OLIN_ANALYST_TOKEN=
# Only required if the legacy STP webhook is intentionally enabled:
OLIN_STP_WEBHOOK_SECRET=
# Required for provider/bank callbacks containing derived bank metrics.
OLIN_BANK_WEBHOOK_SECRET=
# Preferred for bank isolation and controlled key rotation. Values may be one
# secret or [current, retiring] secrets, each at least 32 characters.
# OLIN_BANK_WEBHOOK_SECRETS={"banco-ejemplo":["current-secret","retiring-secret"]}
OLIN_BANK_WEBHOOK_SECRETS=
# Per-instance safety limit. Use the bank/API gateway for distributed limiting.
OLIN_RATE_LIMIT_PER_MINUTE=120
OLIN_MAX_REQUEST_WORKERS=16
OLIN_REQUIRE_SHORT_LIVED_SESSIONS=0
OLIN_SESSION_SECRET=
OLIN_SESSION_TTL_MINUTES=15

# Real bank/customer data remains disabled until managed PostgreSQL,
# encryption/KMS, tested backups and the complete production preflight are active.
OLIN_REAL_DATA_ENABLED=0
OLIN_DATABASE_URL=
OLIN_DATABASE_TLS_ATTESTED=0
OLIN_KMS_KEY_ID=
OLIN_DATABASE_ENCRYPTION_AT_REST=
OLIN_BACKUP_RESTORE_EVIDENCE=
# Must be https:// in a real-data environment.
OLIN_PUBLIC_BASE_URL=
# pseudonymized_historical | identifiable_historical | prospective
OLIN_DATA_CLASSIFICATION=
# Bank ticket/contract references; never paste the underlying personal data.
OLIN_REAL_DATA_SCOPE_REF=
OLIN_DATA_PROCESSING_APPROVAL_REF=
# Pilot retention must be explicit and no longer than 365 days.
OLIN_RETENTION_DAYS=45
OLIN_INCIDENT_OWNER=
OLIN_INCIDENT_CONTACT=
OLIN_REQUIRE_TRUST_REGISTRY=1
OLIN_TRUSTED_SOURCE_REGISTRY_FILE=config/trusted-sources.example.json
# Empty by default. Add a type only after bank/model-risk outcome validation.
OLIN_VALIDATED_AUTO_APPROVE_TYPES=

# ── Consent Flow v1 ─────────────────────────────────────────────────
# HMAC secret used to protect OTPs and delivery destinations at rest.
# Required in pilot/production; use a distinct random value of 32+ characters.
OLIN_CONSENT_OTP_SECRET=
# synthetic is demo/test only. Pilot/production requires an approved adapter.
OLIN_CONSENT_OTP_MODE=synthetic
# Emergency migration switch only. Keep 0 for every new pilot deployment.
OLIN_ALLOW_LEGACY_CONSENT=0

# ── Durable operational alerts ──────────────────────────────────────
# Leave OLIN_ALERT_EMAIL empty to append alerts to logs/alerts.log.
OLIN_ALERT_EMAIL=
OLIN_SMTP_HOST=localhost
OLIN_SMTP_PORT=25
OLIN_SMTP_USERNAME=
OLIN_SMTP_PASSWORD=
OLIN_SMTP_USE_TLS=0
OLIN_SMTP_FROM=
# Public design-partner waitlist. Generate a key with:
# python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
OLIN_WAITLIST_ENCRYPTION_KEY=
OLIN_WAITLIST_ALLOWED_ORIGINS=https://olin-credit.olin-mx.workers.dev

# ── Syncfy (open banking connector — replaced Belvo in MX) ───────────
# Get your key at: https://syncfy.com/developers
SYNCFY_API_KEY=your_syncfy_api_key_here

# ── Google Places API (Maps rating + business tenure) ─────────────────
# Enable "Places API" in Google Cloud Console, then create an API key.
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# ── STP / SPEI (disbursement rail) ────────────────────────────────────
# Credentials provided by STP when you register as a participant.
# Set STP_SANDBOX=1 for demo.stpmex.com (no real certs needed).
# Set STP_SANDBOX=0 for production (cert + key required).
STP_EMPRESA=YOURCODE
STP_CUENTA_ORDENANTE=000000000000000000
STP_RFC_ORDENANTE=OLI200101AB1
STP_PRIVATE_KEY_PATH=./certs/stp_private_key.pem
STP_CERT_PATH=./certs/stp_cert.pem
STP_SANDBOX=1

# ── Database ──────────────────────────────────────────────────────────
# Default: olin_scoring.db in the project root.
# Override to use an absolute path in production.
# OLIN_DB_PATH=/var/data/olin_scoring.db
# Olin runtime: demo | production | test
OLIN_MODE=demo

# Required in production for analyst API actions and STP webhooks
OLIN_ANALYST_TOKEN=
OLIN_STP_WEBHOOK_SECRET=

# ── Durable operational alerts ──────────────────────────────────────
# Leave OLIN_ALERT_EMAIL empty to append alerts to logs/alerts.log.
OLIN_ALERT_EMAIL=
OLIN_SMTP_HOST=localhost
OLIN_SMTP_PORT=25
OLIN_SMTP_USERNAME=
OLIN_SMTP_PASSWORD=
OLIN_SMTP_USE_TLS=0
OLIN_SMTP_FROM=
